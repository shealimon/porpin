# Production build for https://www.porpin.com on Vercel.
#
# Browsers block HTTPS → http:// API calls (mixed content → Axios "Network Error").
# Same-origin (/api, /upload, …) via vercel.json rewrites works for quick calls; heavy uploads + PDF estimate
# often hit gateway timeouts → 502/504. When your API has HTTPS (e.g. api.porpin.com), set VITE_BACKEND_ORIGIN
# to that origin and add the site URL to the API's CORS_ORIGINS so uploads bypass Vercel's proxy.
#
# Leave VITE_BACKEND_ORIGIN blank only while relying entirely on vercel.json → VM (may 502 on large/slow PDFs).

VITE_SITE_ORIGIN=https://www.porpin.com

# Overrides frontend/.env — required so production builds never inherit http:// backend URLs (mixed content).
VITE_BACKEND_ORIGIN=

VITE_API_BASE_URL=/api

# Razorpay publishable key id (must match RAZORPAY_KEY_ID on the API).
VITE_RAZORPAY_KEY_ID=rzp_live_SgRvW2J1ywe6Dj

VITE_SUPABASE_URL=https://zosbmtfvnxdjujobmndr.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inpvc2JtdGZ2bnhkanVqb2JtbmRyIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzUwMzUxMjcsImV4cCI6MjA5MDYxMTEyN30.jajEQ0fIcthSuzPvtLTnw0E3f0IU8dn_9xTbeTenKuw
